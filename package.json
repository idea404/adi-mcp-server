{
  "name": "adi-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for ADI Chain: canonical bridge, CCIP, and network tools for AI agents",
  "type": "module",
  "bin": {
    "adi-mcp-server": "./dist/cli.js"
  },
  "files": ["dist", "src/abis"],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node --format esm",
    "start": "node dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "viem": "^2.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  },
  "license": "MIT"
}
